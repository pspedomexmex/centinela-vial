# Centinela Vial — Variables de entorno requeridas

# Token del bot de Telegram (obtenlo con @BotFather)
TELEGRAM_BOT_TOKEN=tu_token_aqui

# Google Maps API Key (habilitar: Directions API + Geocoding API)
GMAPS_KEY=tu_key_aqui

# X/Twitter API Bearer Token (opcional — Free tier funciona)
TWITTER_BEARER_TOKEN=tu_bearer_token_aqui

# Configuración de intervalos (en minutos)
CHECK_INTERVAL_MIN=30       # Cada cuánto revisar incidentes
TRAFFIC_INTERVAL_MIN=60     # Cada cuánto reportar tráfico

# Ruta de la base de datos SQLite (Railway usa /tmp)
DB_PATH=/tmp/centinela_vial.db
