# ─────────────────────────────────────────────────────────────────────────────
# Centinela Vial — Plantilla de variables de entorno
#
# Copia este archivo a .env SOLO para pruebas locales:   cp .env.example .env
# NUNCA pongas valores reales aquí ni commitees tu .env (está en .gitignore).
# En producción (Vercel) estas variables van en:
#   Dashboard del proyecto → Settings → Environment Variables
# ─────────────────────────────────────────────────────────────────────────────

# ── Obligatorias ─────────────────────────────────────────────────────────────

# Token del bot de Telegram (lo da @BotFather)
TELEGRAM_BOT_TOKEN=

# API key de TomTom Traffic (incidentes y flujo vial). Free tier suficiente.
TOMTOM_KEY=

# ── Opcionales (el bot funciona sin ellas, con capacidades reducidas) ────────

# Google Maps API Key — habilita Directions API + Geocoding API.
# Mejora el cálculo de ruta y el estado de tráfico en /trafico.
GMAPS_KEY=

# Groq API Key — habilita el agente IA (preguntas en lenguaje natural). Free tier.
GROQ_API_KEY=

# X/Twitter Bearer Token — fuente opcional de avisos viales (el Free tier basta).
TWITTER_BEARER_TOKEN=

# ── Estado compartido en Upstash Redis (producción con webhook de Vercel) ────
# Necesarias para que el webhook (Vercel) y el monitor de alertas compartan los
# viajes activos. Si NO se definen, el proyecto cae a estado en archivos JSON
# (modo local/tests). Crea una base gratis en https://console.upstash.com
# (Redis → Create database) y copia estos dos valores de la pestaña "REST API".
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Secreto que protege el endpoint de monitoreo api/monitor.py. Invéntalo con
# `openssl rand -hex 16`. El programador externo (cron-job.org) debe enviarlo.
MONITOR_SECRET=

# Secreto del webhook de Telegram (header X-Telegram-Bot-Api-Secret-Token).
# Invéntalo con `openssl rand -hex 16`; debe coincidir con el registrado en Telegram.
WEBHOOK_SECRET=

# ── Configuración (opcional; tienen valores por defecto sensatos) ────────────

# Carpeta del estado JSON cuando NO se usa Redis (local/tests). Por defecto: ./state
# STATE_DIR=state

# Segundos de espera del sondeo long-polling en bot/poll.py (por defecto 20).
# POLL_TIMEOUT_SEG=20
