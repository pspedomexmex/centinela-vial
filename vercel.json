{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "builds": [
    {
      "src": "api/setup.py",
      "use": "@vercel/python"
    },
    {
      "src": "api/webhook.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "50mb",
        "includeFiles": [
          "bot/**",
          "sources/**",
          "regions/**",
          "db/**"
        ]
      }
    },
    {
      "src": "api/monitor.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "50mb",
        "includeFiles": [
          "bot/**",
          "sources/**",
          "regions/**",
          "db/**",
          "monitor/**"
        ]
      }
    }
  ],
  "routes": [
    { "src": "/api/webhook", "dest": "/api/webhook.py" },
    { "src": "/api/monitor", "dest": "/api/monitor.py" },
    { "src": "/api/setup",   "dest": "/api/setup.py" }
  ]
}
