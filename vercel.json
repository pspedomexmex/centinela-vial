{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/webhook.py": {
      "memory": 512,
      "maxDuration": 30,
      "includeFiles": "{bot,sources,regions,db}/**"
    },
    "api/monitor.py": {
      "memory": 512,
      "maxDuration": 60,
      "includeFiles": "{bot,sources,regions,db,monitor}/**"
    }
  }
}
